{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "include": [
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "mix.exs",
    ".formatter.exs",
    ".credo.exs",
    "build_support/**/*.{ex,exs}",
    "ops/**/*.{ex,exs}",
    "config/**/*.{ex,exs}",
    "lib/**/*.{ex,exs}",
    "test/**/*.{ex,exs}",
    "integration/**/*.{ex,exs}",
    "guides/**/*.md",
    "docs/**/*.md",
    "core/*/README.md",
    "core/*/CHANGELOG.md",
    "core/*/guides/**/*.md",
    "core/*/docs/**/*.md",
    "core/*/mix.exs",
    "core/*/.formatter.exs",
    "core/*/.credo.exs",
    "core/*/config/**/*.{ex,exs}",
    "core/*/lib/**/*.{ex,exs}",
    "core/*/test/**/*.{ex,exs}",
    "core/*/integration/**/*.{ex,exs}",
    "core/*/priv/sql/**/*.sql",
    "core/*/priv/static/**/*.{js,ts}",
    "apps/*/README.md",
    "apps/*/CHANGELOG.md",
    "apps/*/guides/**/*.md",
    "apps/*/docs/**/*.md",
    "apps/*/mix.exs",
    "apps/*/.formatter.exs",
    "apps/*/.credo.exs",
    "apps/*/config/**/*.{ex,exs}",
    "apps/*/lib/**/*.{ex,exs}",
    "apps/*/test/**/*.{ex,exs}",
    "apps/*/integration/**/*.{ex,exs}",
    "apps/*/priv/sql/**/*.sql",
    "apps/*/priv/static/**/*.{js,ts}"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/_build/**",
      "**/deps/**",
      "**/doc/**",
      "**/tmp/**",
      "**/dist/**",
      "**/fixtures/**",
      "**/.blitz/**",
      "**/node_modules/**",
      "**/mix.lock",
      "repomix-output.*"
    ]
  }
}
